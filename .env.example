# Settings for the Docker stack. Copy to .env and edit:
#   cp .env.example .env
# docker compose reads .env automatically; apply changes with
#   docker compose up -d
# These override gateway/config.json in memory. The file is never rewritten.

# influx (hybrid: time series in InfluxDB, inventory in gateway_meta.db)
# or sqlite (everything in gateway/data/gateway.db, as before)
GATEWAY_STORE_BACKEND=influx

# InfluxDB database name
INFLUX_DB=aiot_blp

# Durations: a number followed by w, d, h, m or s.
# How long every raw reading is kept. Shortening it deletes older data.
INFLUX_RAW_RETENTION=7d
# Rollup bucket size (mean/min/max/count per bucket), used for history
# older than the raw retention.
INFLUX_ROLLUP_PERIOD=5m
# How long rollups are kept. Shortening it deletes older data.
INFLUX_ROLLUP_RETENTION=52w

# Only store frames from this kit_id. Empty = all kits.
GATEWAY_KIT_ID=
# BlueZ adapter, e.g. hci0. Empty = default adapter.
GATEWAY_BLE_ADAPTER=

# Grafana admin login (user "admin"). Viewers need no login.
# Read only on Grafana's first start; to change it later see gateway/README.md.
# The default is public in this repository: change it on a shared network.
GRAFANA_ADMIN_PASSWORD=radiostudio

# Host ports
DASHBOARD_PORT=8931
MCP_PORT=8000
GRAFANA_PORT=3000
