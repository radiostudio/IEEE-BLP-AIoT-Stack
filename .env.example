# Settings for the Docker stack. Copy to .env and edit:
#   cp .env.example .env
# docker compose reads .env automatically; apply changes with
#   docker compose up -d
# These override gateway/config.json in memory. The file is never rewritten.

# influx (hybrid: time series in InfluxDB, inventory in gateway_meta.db)
# or sqlite (everything in gateway/data/gateway.db, as before)
GATEWAY_STORE_BACKEND=influx

# InfluxDB database name
INFLUX_DB=aiot_blp

# InfluxDB logins. Only the gateway may change or delete data:
#   admin   (gateway)                      INFLUX_ADMIN_PASSWORD
#   mcp     (MCP server: read, add notes)  INFLUX_MCP_PASSWORD
#   reader  (Jupyter, Streamlit, Grafana)  INFLUX_READ_PASSWORD
# Required: docker compose stops until all three are set. Use letters and
# digits only. Keep the admin and mcp ones secret: anyone with them can
# change data. Students see the reader one, which is harmless.
# Used to create the users on the first start (empty database). To change
# a password later, or to add login to an install that already has data,
# see UNO_Q_DEPLOY_TEST.md "Database users".
INFLUX_ADMIN_PASSWORD=
INFLUX_MCP_PASSWORD=
INFLUX_READ_PASSWORD=

# Durations: a number followed by w, d, h, m or s.
# How long every raw reading is kept. Shortening it deletes older data.
INFLUX_RAW_RETENTION=7d
# Rollup bucket size (mean/min/max/count per bucket), used for history
# older than the raw retention.
INFLUX_ROLLUP_PERIOD=5m
# How long rollups are kept. Shortening it deletes older data.
INFLUX_ROLLUP_RETENTION=52w

# Only store frames from this kit_id. Empty = all kits.
GATEWAY_KIT_ID=
# BlueZ adapter, e.g. hci0. Empty = default adapter.
GATEWAY_BLE_ADAPTER=

# Grafana admin login (user "admin"). Viewers need no login.
# Read only on Grafana's first start; to change it later see gateway/README.md.
# The default is public in this repository: change it on a shared network.
GRAFANA_ADMIN_PASSWORD=radiostudio

# Host ports
DASHBOARD_PORT=8931
MCP_PORT=8000
GRAFANA_PORT=3000
JUPYTER_PORT=8888
STREAMLIT_PORT=8501

# JupyterLab login token (also the password field on its login page).
# Anyone with it can run commands in the jupyter container. The default is
# public in this repository: change it on a shared network.
JUPYTER_TOKEN=radiostudio

# Time zone of JupyterLab and Streamlit: the clock in notebooks and the times
# in aiot_data tables and charts. A name from the tz database, e.g.
# Asia/Kolkata (IST) or UTC. InfluxDB, Grafana and the dashboard are not
# affected (Grafana and the dashboard use the browser's time zone).
TZ=Asia/Kolkata

# Classroom limits for JupyterLab (see UNO_Q_DEPLOY_TEST.md, "Classroom use").
# A notebook that runs nothing for this many seconds is stopped (900 = 15 min).
JUPYTER_IDLE_SECONDS=900
# Memory for all notebooks together. A full example notebook takes about
# 350 MB, so 20g is enough for about 50 students. Keep it a few GB below the
# machine's free memory, so the gateway, InfluxDB and Grafana keep theirs.
JUPYTER_MEMORY_LIMIT=20g
